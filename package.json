{
  "name": "azure-launcher",
  "version": "1.1.3",
  "description": "Azure Luncher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/prepare-win-codesign.js",
    "dist": "node --no-deprecation node_modules/electron-builder/out/cli/cli.js --publish=always",
    "dist:local": "node --no-deprecation node_modules/electron-builder/out/cli/cli.js --publish=never",
    "dist:linux": "node --no-deprecation node_modules/electron-builder/out/cli/cli.js --linux"
  },
  "keywords": [],
  "author": "Studio Ethereal",
  "license": "ISC",
  "dependencies": {
    "@xmcl/core": "^2.15.1",
    "@xmcl/curseforge": "^2.2.0",
    "@xmcl/installer": "^6.1.2",
    "@xmcl/mod-parser": "^3.4.2",
    "@xmcl/modrinth": "^2.5.0",
    "@xmcl/system": "^2.2.9",
    "axios": "^1.14.0",
    "crafatar": "^1.1.0",
    "discord-oauth2": "^2.12.1",
    "discord-rpc": "^4.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "firebase": "^12.11.0",
    "fs-extra": "^11.3.4",
    "mc-server-status": "^2.0.2",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "prismarine-nbt": "^2.8.0",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "discord.js": "^14.15.1",
    "@discordjs/rest": "^1.6.0",
    "discord-api-types": "^0.37.51"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.azure.launcher",
    "productName": "Azure Launcher",
    "copyright": "Copyright © 2026 Azure Launcher",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "asar": true,
    "nodeGypRebuild": false,
    "detectUpdateChannel": false,
    "toolsets": {
      "winCodeSign": "1.0.0"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "StudioEthereal",
        "repo": "Azure-Launcher"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Azure-Launcher.ico",
      "artifactName": "AzureLauncher-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Azure Launcher",
      "installerIcon": "Azure-Launcher.ico",
      "uninstallerIcon": "Azure-Launcher.ico",
      "uninstallDisplayName": "Azure Launcher (Desinstalar)"
    }
  }
}
